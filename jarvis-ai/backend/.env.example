# JARVIS AI backend configuration.
# Copy this file to .env (next to package.json) and fill in your own values.
# NEVER commit .env, and never put these values in the Android or Windows app.
# On a cloud host, set these as the host's environment variables / secrets instead.

# --- Required ---------------------------------------------------------------

# Password the apps use ONCE to pair. Use 16+ random characters. After pairing,
# each device gets its own revocable token, so the password isn't stored on the phone.
JARVIS_PASSWORD=change-me-to-a-long-random-password

# Your Anthropic API key, from https://platform.claude.com (Settings > API keys).
# Set a monthly spend limit there too (Settings > Limits).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- AI models --------------------------------------------------------------

# Models offered in the apps' Settings, as provider:model-id|Label, comma separated
# (no commas inside labels). The first one is the default unless DEFAULT_MODEL is set.
# AI_MODELS=anthropic:claude-opus-5-5|Claude Opus 5.5 (most capable),anthropic:claude-sonnet-5-5|Claude Sonnet 5.5 (faster and cheaper),anthropic:claude-haiku-5-5|Claude Haiku 5.5 (fastest and cheapest)
# DEFAULT_MODEL=anthropic:claude-opus-5-5

# How hard the model thinks: low | medium | high | xhigh | max. Higher = smarter but slower and pricier.
# AI_EFFORT=medium
# MAX_OUTPUT_TOKENS=32000

# Offline demo with no AI at all (canned replies, free): set AI_PROVIDER=mock and leave AI_MODELS unset.
# AI_PROVIDER=mock

# Any OpenAI-compatible provider (OpenAI, OpenRouter, Groq, a local Ollama...), used by "openai:" models.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your-other-provider-key
# Example: AI_MODELS=anthropic:claude-opus-5-5|Claude Opus 5.5,openai:gpt-model-name|Other provider

# --- Web search (Anthropic models only) --------------------------------------
# Uses Anthropic's built-in web search tool: about $10 per 1,000 searches, plus tokens.
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_MAX_USES=5

# --- Spending and privacy ----------------------------------------------------

# Stop answering once today's ESTIMATED spend reaches this many US dollars (0 = no limit).
# Your provider's own spend limit is the real safety net; this is a second one.
DAILY_BUDGET_USD=2

# Delete conversations not touched for this many days (0 = keep until you delete them).
# HISTORY_RETENTION_DAYS=0

# --- Server --------------------------------------------------------------------

# PORT=8787
# HOST=0.0.0.0
# Where the SQLite database lives. Mount a persistent disk here on a cloud host.
# DATA_DIR=./data
# Set to true when running behind a reverse proxy / load balancer that terminates HTTPS
# (Fly.io, Render, Caddy, nginx), so rate limiting sees real client IPs.
# TRUST_PROXY=false
# Web origins allowed to call the API (the Android and Windows apps' internal origins).
# CORS_ORIGINS=https://appassets.androidplatform.net,https://jarvis.app.local
# Also serve the JARVIS web UI at / for use in a browser.
# SERVE_WEB_UI=true
