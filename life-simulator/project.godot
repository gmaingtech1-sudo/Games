; Engine configuration file.
; LIFE SIMULATOR - Build Your Life. Your Way.

config_version=5

[application]

config/name="Life Simulator"
config/description="Build Your Life. Your Way. A 3D open-world life simulation."
config/version="1.0.0"
run/main_scene="res://scenes/main/boot.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.png"
config/quit_on_go_back=false
run/low_processor_mode=false

[autoload]

DataDB="*res://autoload/DataDB.gd"
Settings="*res://autoload/Settings.gd"
WorldClock="*res://autoload/WorldClock.gd"
GameManager="*res://autoload/GameManager.gd"
EconomyManager="*res://autoload/EconomyManager.gd"
SaveManager="*res://autoload/SaveManager.gd"
MissionManager="*res://autoload/MissionManager.gd"
AchievementManager="*res://autoload/AchievementManager.gd"
AudioManager="*res://autoload/AudioManager.gd"
MultiplayerManager="*res://autoload/MultiplayerManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[input]

