extends Node
## Music and sound effects. All audio is original, generated by tools/make_audio.py.
## Music fades between tracks; SFX use a small pool of players.

const SFX := {
	"ui_click": "res://assets/sounds/ui_click.wav",
	"ui_confirm": "res://assets/sounds/ui_confirm.wav",
	"ui_error": "res://assets/sounds/ui_error.wav",
	"notify": "res://assets/sounds/notify.wav",
	"mission": "res://assets/sounds/mission.wav",
	"achievement": "res://assets/sounds/achievement.wav",
	"cash": "res://assets/sounds/cash.wav",
	"door": "res://assets/sounds/door.wav",
	"step_walk": "res://assets/sounds/step_walk.wav",
	"step_run": "res://assets/sounds/step_run.wav",
	"jump": "res://assets/sounds/jump.wav",
	"horn": "res://assets/sounds/horn.wav",
	"crash": "res://assets/sounds/crash.wav",
	"checkpoint": "res://assets/sounds/checkpoint.wav",
	"phone": "res://assets/sounds/phone.wav",
}
const LOOPS := {
	"engine": "res://assets/sounds/engine_loop.wav",
	"rain": "res://assets/sounds/rain_loop.wav",
}
const MUSIC := {
	"menu": "res://assets/music/menu_theme.ogg",
	"city": "res://assets/music/city_day.ogg",
	"night": "res://assets/music/city_night.ogg",
	"race": "res://assets/music/race.ogg",
}

var _streams := {}
var _pool: Array[AudioStreamPlayer] = []
var _music_a: AudioStreamPlayer
var _music_b: AudioStreamPlayer
var _current_music := ""
var _rain: AudioStreamPlayer


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in 8:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_pool.append(p)
	_music_a = AudioStreamPlayer.new()
	_music_b = AudioStreamPlayer.new()
	for m in [_music_a, _music_b]:
		m.bus = "Music"
		m.volume_db = -80.0
		add_child(m)
	_rain = AudioStreamPlayer.new()
	_rain.bus = "SFX"
	_rain.volume_db = -14.0
	add_child(_rain)


func stream(path: String) -> AudioStream:
	if _streams.has(path):
		return _streams[path]
	var s: AudioStream = null
	if ResourceLoader.exists(path):
		s = load(path)
	_streams[path] = s
	return s


func loop_stream(key: String) -> AudioStream:
	return stream(LOOPS.get(key, ""))


func play_sfx(key: String, pitch: float = 1.0, volume_db: float = 0.0) -> void:
	if not SFX.has(key):
		return
	var s := stream(SFX[key])
	if s == null:
		return
	for p in _pool:
		if not p.playing:
			p.stream = s
			p.pitch_scale = pitch
			p.volume_db = volume_db
			p.play()
			return
	_pool[0].stream = s
	_pool[0].play()


func play_music(key: String, fade: float = 1.5) -> void:
	if key == _current_music or not MUSIC.has(key):
		return
	_current_music = key
	var s := stream(MUSIC[key])
	if s == null:
		return
	if s is AudioStreamOggVorbis:
		(s as AudioStreamOggVorbis).loop = true
	var incoming := _music_b if _music_a.playing else _music_a
	var outgoing := _music_a if incoming == _music_b else _music_b
	incoming.stream = s
	incoming.volume_db = -40.0
	incoming.play()
	var tw := create_tween().set_parallel(true)
	tw.tween_property(incoming, "volume_db", -6.0, fade)
	if outgoing.playing:
		tw.tween_property(outgoing, "volume_db", -60.0, fade)
		tw.chain().tween_callback(outgoing.stop)


func stop_music(fade: float = 1.0) -> void:
	_current_music = ""
	var tw := create_tween().set_parallel(true)
	for m in [_music_a, _music_b]:
		if m.playing:
			tw.tween_property(m, "volume_db", -60.0, fade)
	tw.chain().tween_callback(func(): _music_a.stop(); _music_b.stop())


func set_rain(on: bool) -> void:
	if on and not _rain.playing:
		_rain.stream = loop_stream("rain")
		if _rain.stream:
			_rain.play()
	elif not on and _rain.playing:
		_rain.stop()
